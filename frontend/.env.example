# Defaults to the explicitly synthetic snapshot bundled in public/data.
VITE_DATA_MODE=fixture
VITE_SNAPSHOT_PATH=data/snapshot.json
# Optional fixed deployment prefix. Default ./ supports any static directory.
# VITE_BASE_PATH=/OpenVerifiableLLM/
# Development only. Has no effect in production builds.
# VITE_SCENARIO=empty
# VITE_MOCK_INFERENCE=true
